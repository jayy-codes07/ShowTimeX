# ShowTimeX — frontend environment template
# Copy to `.env` and fill in real values. NEVER commit the filled-in .env.
# Every value below is a PLACEHOLDER, not a real credential.
#
# WARNING: anything prefixed with VITE_ is embedded into the built JavaScript
# bundle and is publicly visible. Only ever put publishable values here.

# ─── API ──────────────────────────────────────────────────────────────
# Base URL of the ShowTimeX backend. Must include the /api suffix.
# Production example: https://<your-backend-host>/api
VITE_API_BASE_URL=http://localhost:5000/api

# ─── Payments (Razorpay) ──────────────────────────────────────────────
# Razorpay publishable key_id ONLY — safe to expose in the browser.
# NEVER put RAZORPAY_KEY_SECRET here; it belongs in backend/.env.
VITE_RAZORPAY_KEY=rzp_test_<your_key_id>
