# ShowTimeX — backend environment template
# Copy to `.env` and fill in real values. NEVER commit the filled-in .env.
# Every value below is a PLACEHOLDER, not a real credential.

# ─── Server ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────
# MongoDB Atlas connection string (contains DB username + password).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────
# Generate a long random value, e.g.  openssl rand -hex 32
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRE=7d

# ─── Frontend origin ──────────────────────────────────────────────────
# NOTE: defined here but not yet read anywhere in the code.
# Intended to scope CORS in a later phase (currently `app.use(cors())`).
CLIENT_URL=http://localhost:5173

# ─── Payments (Razorpay) ──────────────────────────────────────────────
# KEY_ID is publishable and is also shipped to the browser.
# KEY_SECRET is secret and must never reach the frontend.
RAZORPAY_KEY_ID=rzp_test_<your_key_id>
RAZORPAY_KEY_SECRET=<your_razorpay_key_secret>

# ─── External APIs ────────────────────────────────────────────────────
# TMDB v3 API key. Proxied server-side only — never exposed to the browser.
TMDB_API_KEY=<your_tmdb_v3_api_key>

# ─── Automation ───────────────────────────────────────────────────────
# Capability URL: anyone holding it can trigger the workflow. Treat as secret.
N8N_WEBHOOK_URL=https://<your-n8n-host>/webhook/<path>

# ─── Email (SMTP) ─────────────────────────────────────────────────────
# If SMTP_HOST is unset, backend/utils/sendEmail.js silently falls back to a
# throwaway Ethereal test inbox — password-reset mail will NOT reach real users.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=<your_smtp_account@example.com>
SMTP_PASSWORD=<your_smtp_app_password>

# Read by backend/utils/sendEmail.js:36 but currently absent from .env, so the
# code falls back to "ShowTimeX <noreply@showtimex.com>".
FROM_NAME=ShowTimeX
FROM_EMAIL=noreply@example.com

# ─── Optional tuning (safe in-code defaults shown) ────────────────────
# SEAT_LOCK_MINUTES=10
# MIN_BOOKING_LEAD_MINUTES=60
# SHOW_TIMEZONE_OFFSET_MINUTES=330
